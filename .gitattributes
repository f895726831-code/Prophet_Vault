# Normalise line endings in the repository: LF in the index and in the working tree on
# every platform. Generated artefacts are written with LF by prophet_vault._io, so a
# snapshot regenerated on Windows is byte-identical to one regenerated on Linux.
* text=auto eol=lf

# Source and data
*.py text
*.toml text
*.yml text
*.md text
*.csv text
*.json text
*.html text

# Prophet / vendor binary formats must never be touched
*.PRW binary
*.RCI binary
*.fac binary
*.rar binary
*.zip binary
*.pdf binary
*.png binary
*.jpg binary
