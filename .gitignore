# Local model data: never commit a real Prophet workspace
*.PRW
*.prw
*.RCI
*.rci
*.fac
*.rar
*.zip
*.7z

# Generated working output (the curated demo under examples/ is committed)
/output/
/snapshots/
/diffs/
/examples/vault/
smoke/

# NB: the default vault folder (`Prophet_Vault/`) is deliberately NOT ignored here.
# On a case-insensitive filesystem (Windows, macOS) `Prophet_Vault/` also matches the
# `prophet_vault/` package directory, which silently hid new package files from git.
# Add a local rule if you generate a vault inside this repository.

# Obsidian per-user state inside a generated vault
.obsidian/workspace*.json
.obsidian/cache
.obsidian/app.json
.obsidian/core-plugins.json

# Local overrides
.env
